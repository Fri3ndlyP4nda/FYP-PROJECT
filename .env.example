APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# This application stores every domain model in MongoDB. The models pin
# $connection = 'mongodb', so a sqlite default leaves the app running against an
# empty file where every query fails.
DB_CONNECTION=mongodb
DB_URI="mongodb://127.0.0.1:27017"
DB_DATABASE=apel_management

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
# Leave unset in production: it defaults to true outside local.
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# 'sync' sends mail inline and blocks the request on SMTP. Use a real driver
# and run `php artisan queue:work` so notifications leave the request cycle.
# Mail is dispatched to a queue. With 'sync' it is NOT queued at all - it sends
# inline and the HTTP request blocks on the SMTP round trip, and assignEvaluator
# sends three, so an admin waits on three TLS handshakes before the page returns.
# Requires a worker: php artisan queue:work  (composer dev starts one for you)
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Two-factor authentication. Set true to require an emailed one-time code at login.
APEL_2FA_ENABLED=false

# Seeded demo accounts (database/seeders/UserSeeder.php). Set these in any
# deployed environment so it never inherits the documented defaults.
SEED_STUDENT_PASSWORD=
SEED_EVALUATOR_PASSWORD=
SEED_ADMIN_PASSWORD=
